#!/bin/sh
# Run cargo without starving the rest of the machine, then prune old builds.
#
#     scripts/cargo build --release
#     scripts/cargo test --workspace
#
# Same arguments as cargo. It adds three things:
#   - a cap on how fast the build may write to disk, so a big link cannot
#     freeze the desktop (nice and ionice do not limit disk writes here)
#   - low CPU priority, at most 4 parallel jobs, and a hard limit on total
#     CPU time (4 jobs alone is not a limit: each compiler and each test
#     binary runs many threads)
#   - scripts/sweep-target.py afterwards, which keeps the last 3 builds
#
# TERSE_WRITE_CAP changes the write cap (default 60M per second).
# TERSE_CPU_QUOTA changes the CPU limit (default 500%, that is 5 cores).

root=$(cd "$(dirname "$0")/.." && pwd)
cap=${TERSE_WRITE_CAP:-60M}
cpu=${TERSE_CPU_QUOTA:-500%}
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-4}"

if systemd-run --user --scope --quiet -p "CPUQuota=$cpu" -p "IOWriteBandwidthMax=$root $cap" true 2>/dev/null; then
    systemd-run --user --scope --quiet -p "CPUQuota=$cpu" -p "IOWriteBandwidthMax=$root $cap" nice -n 15 cargo "$@"
else
    echo "scripts/cargo: no write or CPU cap available, running without it" >&2
    nice -n 15 cargo "$@"
fi
status=$?

"$root/scripts/sweep-target.py" >&2
exit $status
