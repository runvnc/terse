# A public Tersenet relay (README "Running a public relay").
#
#   sudo useradd --system --home /var/lib/terse-relay --create-home terse-relay
#   sudo install -m 755 terse-relay /usr/local/bin/
#   sudo install -d -o terse-relay /etc/terse-relay
#   sudo -u terse-relay touch /etc/terse-relay/writers     # one feed key a line
#   sudo cp terse-relay.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now terse-relay
#
# The relay listens on loopback only: a Cloudflare Tunnel (cloudflared,
# README "Running a public relay") carries wss://relay.tersenet.org to it,
# so the server opens no port, and every connection comes from cloudflared
# on loopback (hence --trust-proxy 127.0.0.1,::1).
#
# Without Cloudflare, the relay can serve wss:// itself: --listen 0.0.0.0:443
# --tls-cert <fullchain.pem> --tls-key <privkey.pem>, no --trust-proxy, and
# AmbientCapabilities=CAP_NET_BIND_SERVICE below; a renewed certificate is
# read on reload (certbot --deploy-hook "systemctl reload terse-relay").
#
# The status: journalctl -u terse-relay | grep status, or
# cat /run/terse-relay/status. A changed writers file is read within 2 s
# (or at once: systemctl reload terse-relay, which also reads a
# --tls-cert again).

[Unit]
Description=Tersenet relay
After=network-online.target
Wants=network-online.target

[Service]
User=terse-relay
ExecStart=/usr/local/bin/terse-relay --public \
    --listen 127.0.0.1:7878 \
    --store /var/lib/terse-relay/store \
    --max-store-bytes 12G \
    --max-connections 256 \
    --writers /etc/terse-relay/writers \
    --trust-proxy 127.0.0.1,::1 \
    --status-file /run/terse-relay/status
ExecReload=/bin/kill -HUP $MAINPID
# SIGTERM closes every connection with a close frame, then exits.
KillSignal=SIGTERM
TimeoutStopSec=10
Restart=on-failure
RestartSec=2
RuntimeDirectory=terse-relay
StateDirectory=terse-relay
# One thread per connection (up to ~2 MiB each while a large put arrives);
# --max-connections 256 keeps that under MemoryMax on a 1 GB server.
LimitNOFILE=4096
TasksMax=512
MemoryMax=600M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/terse-relay

[Install]
WantedBy=multi-user.target
