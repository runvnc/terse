paragraph
  text "A relay: "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example
  text ", then text. Two: "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example:7000,203.0.113.7
  text ". ("
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example
  text ") in parentheses, "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example
  text ": before a colon. IPv6: "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @[2001:db8::1]:7878
  text "; [in brackets "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example
  text "] too. "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example as "With text"
  text " and "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @a.example,b.example:1 as "two"
  text ". A path is not a hint's: "
  link feed fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210 @relay.example
  text "/x."
